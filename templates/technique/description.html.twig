{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Description de la technique{% endblock %}

{% block body %}

    <h1>Technique de dessin</h1>

                <div class="card_description" >
                    <img src="{{ asset('images/')}}{{technique.image}}" class="card-img-top img-fluid"
                         alt="Dessin correspondant à la technique" >
                    <div class="card-body">
                        <h3 class="card-title-description">{{ technique.titre }}</h3>
                        <h4 class="card-subtitle-description mb-2">{{ technique.sousTitre }}</h4>
                    </div>
                </div>
                <div>
                    <p class="card-text-description">{{ technique.description}}</p>
                </div>
{% endblock %}



