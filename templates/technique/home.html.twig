{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Accueil{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
        <button> <a href="{{ path('technique_creer') }}">Créer une technique</a></button>
        <button> <a href="{{ path('app_dessin_valider') }}">Valider les dessins</a></button>
    {% endif %}
    <h1 class="text-center">Consultez les différentes techniques de dessin et partagez vos oeuvres <br> et vos commentaires grâce à la galerie</h1>
    <h2 class="text-center">Articles sur les techniques</h2>
    <div class="card-deck">
        <div class="d-flex my-5 align-content-center justify-content-evenly flex-wrap">
            {% for technique in techniques %}
            <div class="card" >
                <img src="{{ asset('images/')}}{{technique.image}}" class="card-img-top img-fluid"
                     alt="Dessin correspondant à la technique" >
                <div class="card-body">
                    <h3 class="card-title">{{ technique.titre }}</h3>
                    <h4 class="card-subtitle mb-2 ">{{ technique.sousTitre }}</h4>
                    <a href="{{ path('technique_description', {id:technique.id}) }}" class="card-link"
                       title="Voir la description de la technique">Description de la technique</a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}


