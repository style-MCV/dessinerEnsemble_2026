{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Galerie{% endblock %}

{% block body %}
    {% if is_granted('ROLE_USER') %}
        <button> <a href="{{ path('app_dessin_ajouter') }}">Ajouter votre dessin</a></button>
    {% endif %}
    <h1>Admirez les oeuvres des autres et partagez les vôtres ainsi que vos commentaires sur leur réalisation grâce à notre galerie et pour cela, connectez-vous!</h1>

        <div class="card-deck">
            <div class="d-flex my-5 align-content-center justify-content-evenly flex-wrap">
                {% for dessin in dessins %}
                <div class="card" >
                    <img src="{{ asset('images/')}}{{dessin.image}}" class="card-img-top img-fluid" alt="Dessin correspondant à la technique" >
                    <div class="card-body">
                        <h2 class="card-title">{{ dessin.technique.titre }}</h2>
                        <h3 class="card-title mb-2">{{ dessin.titre }}</h3>
                        <h4 class="card-subtitle mb-2">par {{ dessin.auteur.pseudo }}</h4>
                        <p class="card-text">{{ dessin.commentaire}}</p>
                        <p class="card-text">créé le {{ dessin.dateCreation|date("d-m-Y") }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
